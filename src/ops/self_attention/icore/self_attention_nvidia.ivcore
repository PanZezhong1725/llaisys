#include "self_attention_nvidia.hpp"
#include "../../../utils/cuda_check.hpp"
#include <cuda_fp16.h>
#include <cuda_bf16.h>
#include <cmath>
template <typename T> __global__ void attention_kernel(T*out,const T*q,const T*k,const T*v,size_t ql,size_t kl,size_t nh,size_t nkh,size_t d,size_t dv,float scale){size_t i=blockIdx.x*blockDim.x+threadIdx.x;if(i>=ql*nh*dv)return;size_t p=i%dv,h=(i/dv)%nh,qi=i/(nh*dv),kh=h/(nh/nkh),mk=kl-ql+qi,qb=(qi*nh+h)*d;float mx=-INFINITY;for(size_t j=0;j<=mk;j++){float s=0;for(size_t z=0;z<d;z++)s+=float(q[qb+z])*float(k[(j*nkh+kh)*d+z]);s*=scale;if(s>mx)mx=s;}float den=0,ans=0;for(size_t j=0;j<=mk;j++){float s=0;for(size_t z=0;z<d;z++)s+=float(q[qb+z])*float(k[(j*nkh+kh)*d+z]);float a=expf(s*scale-mx);den+=a;ans+=a*float(v[(j*nkh+kh)*dv+p]);}out[i]=T(ans/den);}
namespace llaisys::ops::iluvatar{void self_attention(tensor_t out,tensor_t q,tensor_t k,tensor_t v,float scale,llaisysDataType_t type){size_t ql=q->shape()[0],kl=k->shape()[0],nh=q->shape()[1],nkh=k->shape()[1],d=q->shape()[2],dv=v->shape()[2],n=ql*nh*dv;int blocks=(int)((n+255)/256);switch(type){case LLAISYS_DTYPE_F32:attention_kernel<<<blocks,256>>>((float*)out->data(),(const float*)q->data(),(const float*)k->data(),(const float*)v->data(),ql,kl,nh,nkh,d,dv,scale);break;case LLAISYS_DTYPE_F16:attention_kernel<<<blocks,256>>>((__half*)out->data(),(const __half*)q->data(),(const __half*)k->data(),(const __half*)v->data(),ql,kl,nh,nkh,d,dv,scale);break;case LLAISYS_DTYPE_BF16:attention_kernel<<<blocks,256>>>((__nv_bfloat16*)out->data(),(const __nv_bfloat16*)q->data(),(const __nv_bfloat16*)k->data(),(const __nv_bfloat16*)v->data(),ql,kl,nh,nkh,d,dv,scale);break;default:EXCEPTION_UNSUPPORTED_DATATYPE(type);}CHECK_CUDA(cudaGetLastError());CHECK_CUDA(cudaDeviceSynchronize());}}
