#include "linear_nvidia.hpp"
#include "../../../utils/cuda_check.hpp"
#include <cuda_fp16.h>
#include <cuda_bf16.h>
template <typename T> __global__ void linear_kernel(T *out, const T *in, const T *weight, const T *bias, size_t m, size_t k, size_t n) { size_t idx = blockIdx.x * blockDim.x + threadIdx.x; if (idx >= m*n) return; size_t row=idx/n,col=idx%n; float sum=bias?static_cast<float>(bias[col]):0.0f; for(size_t p=0;p<k;++p) sum += static_cast<float>(in[row*k+p])*static_cast<float>(weight[col*k+p]); out[idx]=static_cast<T>(sum); }
namespace llaisys::ops::iluvatar { void linear(tensor_t out,tensor_t in,tensor_t weight,tensor_t bias,llaisysDataType_t type,size_t) { size_t m=in->shape()[0],k=in->shape()[1],n=weight->shape()[0]; int blocks=(int)((m*n+255)/256); switch(type) { case LLAISYS_DTYPE_F32: linear_kernel<<<blocks,256>>>((float*)out->data(),(const float*)in->data(),(const float*)weight->data(),bias?(const float*)bias->data():nullptr,m,k,n); break; case LLAISYS_DTYPE_F16: linear_kernel<<<blocks,256>>>((__half*)out->data(),(const __half*)in->data(),(const __half*)weight->data(),bias?(const __half*)bias->data():nullptr,m,k,n); break; case LLAISYS_DTYPE_BF16: linear_kernel<<<blocks,256>>>((__nv_bfloat16*)out->data(),(const __nv_bfloat16*)in->data(),(const __nv_bfloat16*)weight->data(),bias?(const __nv_bfloat16*)bias->data():nullptr,m,k,n); break; default: EXCEPTION_UNSUPPORTED_DATATYPE(type); } CHECK_CUDA(cudaGetLastError()); CHECK_CUDA(cudaDeviceSynchronize()); } }
